# Copie este arquivo para ".env" (sem o .example) e preencha com os dados
# do seu recurso no Azure AI Foundry / Azure OpenAI.

# Portal do recurso Azure OpenAI > "Keys and Endpoint"
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=coloque-sua-chave-aqui

# Data da versão da API REST do Azure OpenAI (ajuste se estiver usando
# um modelo/feature que exige uma versão mais nova)
AZURE_OPENAI_API_VERSION=2024-10-21

# Nome do DEPLOYMENT que você criou no Azure AI Foundry / Azure OpenAI Studio
# ao implantar o modelo — NÃO é o nome do modelo (ex.: gpt-4o-mini).
AZURE_OPENAI_DEPLOYMENT=nome-do-seu-deployment
