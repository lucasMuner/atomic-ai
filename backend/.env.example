# Copie este arquivo para ".env" (sem o .example) e preencha com os dados
# do seu projeto no Azure AI Foundry.

# Portal do Azure AI Foundry > seu projeto > "Endpoints and keys"
# Formato: https://<seu-recurso>.services.ai.azure.com/api/projects/<projeto>/openai/v1
AZURE_FOUNDRY_ENDPOINT=https://SEU-RECURSO.services.ai.azure.com/api/projects/SEU-PROJETO/openai/v1
AZURE_FOUNDRY_API_KEY=coloque-sua-chave-aqui

# Nome do MODELO implantado no Foundry (ex.: gpt-5-mini) — não é nome de deployment
AZURE_FOUNDRY_MODEL=gpt-5-mini